# QuickBite Environment Configuration Example
# Copy to .env for local development. Never commit .env or secrets to git.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon)
# e.g., postgresql://placeholder_user:placeholder_password@ep-example.ap-southeast-1.aws.neon.tech/quickbite?sslmode=require
DATABASE_URL=postgresql://quickbite_user:placeholder_password@localhost:5432/quickbite_dev

# Optional Test Database URL (for real PostgreSQL integration tests)
TEST_DATABASE_URL=

# Scheduler Webhook Bearer Secret (shared between Cloudflare Worker and Express server)
# Generate a secure 32+ character random string for production
TICK_SECRET=quickbite_dev_tick_secret_placeholder_change_me_in_prod

# Cloudflare Worker Configuration (when running locally or deploying)
APP_URL=http://localhost:3000
